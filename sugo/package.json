{
  "name": "sugo",
  "version": "0.42.14",
  "description": "Sugo - spec-based harness + enforced state-machine dev pipeline",
  "type": "module",
  "main": "dist/index.bundle.mjs",
  "scripts": {
    "prebuild": "node syncVersion.mjs",
    "build:dashboard": "node ../dashboard/backend/build-bundle.mjs dashboard-runtime",
    "build": "node build.mjs",
    "sync-version": "node syncVersion.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cold-smoke": "node scripts/cold-smoke-core.mjs",
    "cold-smoke:core": "node scripts/cold-smoke-core.mjs",
    "cold-smoke:full": "node scripts/cold-smoke.mjs",
    "release-verify": "node scripts/release-verify.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "js-yaml": "^5.2.1",
    "tree-sitter-wasms": "^0.1.13",
    "web-tree-sitter": "^0.22.6",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^20.14.0",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
