# Sugo Dashboard backend — see spec/sugo-dashboard-spec-v1.md §8.
# Copy to .env and fill in for a real deployment.

PORT=3001

# Comma-separated CORS whitelist - local-only addition (§8 "현재 냄새" fix,
# original had wide-open cors()). Defaults to the Vite dev server port.
CORS_ORIGINS=http://localhost:5173

# DB_DRIVER=mysql (default) uses the values below. DB_DRIVER=sqlite is a
# local-only local dev/test mode (SQLITE_FILE, see docs/roadmap-progress.md) —
# not part of the original spec.
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sugo_dashboard

SECRET_ENC_KEY=
PLUGIN_VERSION=0.1.0

OIDC_ISSUER=
OIDC_AUTH_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

HARNESS_PATH=
RUNNER_POLL_MS=
RUNNER_STUB_WORK_MS=
