# Sugo Console backend.
# Copy to .env and fill in for a real deployment.

PORT=3001

# Comma-separated CORS whitelist. Defaults to the Vite dev server port.
CORS_ORIGINS=http://localhost:5175

# DB_DRIVER=mysql (default) uses the values below. DB_DRIVER=sqlite is the
# local dev/test mode (see SQLITE_FILE below).
DB_DRIVER=mysql
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=sugo_dashboard

# PAT 암호화 키. base64-encoded 32-byte value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Required for /api/bitbucket to work - without it, encryptSecret/decryptSecret throw.
SECRET_ENC_KEY=
PLUGIN_VERSION=0.1.0

OIDC_ISSUER=
OIDC_AUTH_ENDPOINT=
OIDC_TOKEN_ENDPOINT=
OIDC_JWKS_URI=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=

HARNESS_PATH=
RUNNER_POLL_MS=
RUNNER_STUB_WORK_MS=

# ── 공개 SaaS 인증 — GitHub OAuth + HS256 세션 ──────────────────
# 로컬 개발이면 DB_DRIVER=sqlite로 두면 MySQL 없이 스키마 자동생성으로 바로 뜬다.
#   DB_DRIVER=sqlite
#   SQLITE_FILE=./local.db
# 세션/state 서명키(랜덤). node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SESSION_SECRET=
# GitHub OAuth App(Settings→Developer settings→OAuth Apps). callback은 아래와 정확히 일치해야 함.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3001/api/auth/github/callback
GITHUB_SCOPE=read:user
# 로그인 성공 후 세션 토큰을 붙여 리다이렉트할 프론트 주소
FRONTEND_URL=http://localhost:5175
